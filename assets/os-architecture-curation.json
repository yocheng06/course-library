  "questions": {
    "community-5c7a7dab-12ae-412b-b022-bc13900862ef-1": {
      "category": "作業系統服務",
      "explanation": "答案為 B、C、D。B 控制程序對資源的存取，C 防止並行程序互相干擾，D 透過驗證確認使用者身分，三者都屬於保護或安全工作。A 檔案加密是保護資料的技術手段，但不是本題採用的保護服務分類。",
      "clearSubmissionReview": true,
      "sourceSignature": "9cbb580c"
    },
    "community-5c7a7dab-12ae-412b-b022-bc13900862ef-2": {
      "category": "作業系統服務",
      "explanation": "答案為 B：CPU 是執行指令的處理器，不是 I/O 裝置。Keyboard 和 I/O devices 是裝置；File 雖是被讀寫的邏輯資料對象，檔案讀寫仍是 I/O 操作，因此題目中的 device 用語要按「I/O 裝置」理解。",
      "clearSubmissionReview": true,
      "sourceSignature": "4561810c"
    },
    "community-5c7a7dab-12ae-412b-b022-bc13900862ef-3": {
      "category": "作業系統服務",
      "explanation": "答案是 memory（記憶體）。程式要執行，作業系統須先將程式載入記憶體，讓處理器能取出指令；hard disk 是程式的持久儲存位置，cache 是較小的高速暫存層，CPU 是執行指令的處理器而非載入目的地。",
      "clearSubmissionReview": true,
      "sourceSignature": "0a588228"
    },
    "community-5c7a7dab-12ae-412b-b022-bc13900862ef-4": {
      "category": "作業系統服務",
      "explanation": "答案為 B、D。訊息傳遞會把資料或訊息送給另一程序；共享記憶體則讓程序讀寫共同區域。A 系統呼叫是向核心請求服務的介面，不是通訊模型；C 檔案系統管理檔案與目錄，不是本題所問的程序間通訊方式。",
      "clearSubmissionReview": true,
      "sourceSignature": "b70f3a4b"
    },
    "community-5c7a7dab-12ae-412b-b022-bc13900862ef-5": {
      "category": "Unix / FreeBSD",
      "explanation": "答案是 kernel（核心）。在 UNIX 的簡化分層圖中，核心位於系統呼叫介面之下、實體硬體之上，負責處理器、記憶體、檔案及裝置等核心管理工作。",
      "clearSubmissionReview": true,
      "sourceSignature": "3675f779"
    },
    "community-5c7a7dab-12ae-412b-b022-bc13900862ef-6": {
      "category": "使用者介面與系統程式",
      "explanation": "答案為 A、B、C。檔案管理、狀態資訊與語言工具，以及程式載入執行和通訊，都是系統程式常見領域。D 處理器電路設計屬硬體設計，不是作業系統提供的系統程式。",
      "clearSubmissionReview": true,
      "sourceSignature": "b278143e"
    },
    "community-5c7a7dab-12ae-412b-b022-bc13900862ef-7": {
